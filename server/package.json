{
  "name": "civicsync-server",
  "version": "1.0.0",
  "private": true,
  "description": "CivicSync REST API (Express + MongoDB)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "server": "node --watch-path=src --watch-path=.env src/index.js",
    "client": "npm --prefix .. start",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "install-all": "npm install && npm --prefix .. install",
    "seed": "node src/seed/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
